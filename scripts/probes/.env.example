# Copy to the gitignored root .env (or outside the repository), restrict it to mode 600, and fill it
# from your own secret store. Double-quote values: an unquoted # starts a comment.
PAYLOV_BASE_URL=https://dev.gw.paylov.uz
PAYLOV_CONSUMER_KEY=EXAMPLE-KEY-NOT-A-REAL-CREDENTIAL
PAYLOV_CONSUMER_SECRET=EXAMPLE-SECRET-NOT-A-REAL-CREDENTIAL
PAYLOV_USERNAME=EXAMPLE-USERNAME-NOT-A-REAL-CREDENTIAL
PAYLOV_PASSWORD=EXAMPLE-PASSWORD-NOT-A-REAL-CREDENTIAL
# Optional PAN:YYMM:OTP entries, separated by semicolons; never commit actual card data.
PAYLOV_LIVE_TEST_CARDS=
PAYLOV_CAPTURE_DIR=/private/tmp/paylov-probe/captures
# Optional external key=value secret list for scanning existing evidence.
PAYLOV_PROBE_SECRETS_FILE=
