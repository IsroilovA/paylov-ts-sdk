# Copy to the gitignored root .env (or outside the repository), restrict it to mode 600, and fill it
# from your own secret store. Probes and the live suite read it. Double-quote values: an unquoted #
# starts a comment.
PAYLOV_BASE_URL="https://dev.gw.paylov.uz"
PAYLOV_CONSUMER_KEY="EXAMPLE-KEY-NOT-A-REAL-CREDENTIAL"
PAYLOV_CONSUMER_SECRET="EXAMPLE-SECRET-NOT-A-REAL-CREDENTIAL"
PAYLOV_USERNAME="EXAMPLE-USERNAME-NOT-A-REAL-CREDENTIAL"
PAYLOV_PASSWORD="EXAMPLE-PASSWORD-NOT-A-REAL-CREDENTIAL"
# Optional PAN:YYMM:OTP entries, separated by semicolons; never commit actual card data.
PAYLOV_LIVE_TEST_CARDS=""
# Optional key=value secrets (pan, expiry, otp, pinfl, phone; other keys are credentials),
# separated by semicolons, redacted from captures; never commit actual values.
PAYLOV_PROBE_SECRETS=""
# Optional: unset writes to the git-ignored captures/; any other path must be outside the checkout.
PAYLOV_CAPTURE_DIR=""
# Live suite lanes: set per run on the command line, not here, so a plain run stays offline.
# PAYLOV_LIVE=1 PAYLOV_LIVE_WRITES=1 PAYLOV_LIVE_REFUND=1 PAYLOV_LIVE_SLOW=1
